<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleDisplayName</key><string>GameBridge Google OAuth</string>
<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>0.1.0</string>
<key>CFBundleVersion</key><string>1</string>
<key>LSRequiresIPhoneOS</key><true/>
<key>UILaunchScreen</key><dict/>
<key>UIApplicationSceneManifest</key><dict><key>UIApplicationSupportsMultipleScenes</key><false/></dict>
<key>GIDClientID</key><string>$(GAMEBRIDGE_GOOGLE_IOS_CLIENT_ID)</string>
<key>GIDServerClientID</key><string>$(GAMEBRIDGE_GOOGLE_SERVER_CLIENT_ID)</string>
<key>CFBundleURLTypes</key><array><dict><key>CFBundleURLSchemes</key><array><string>$(GAMEBRIDGE_GOOGLE_IOS_REVERSED_CLIENT_ID)</string></array></dict></array>
<key>GameBridgeAppID</key><string>$(GAMEBRIDGE_GOOGLE_APP_ID)</string>
<key>GameBridgeBackendURL</key><string>https://$(GAMEBRIDGE_GOOGLE_BACKEND_HOST):$(GAMEBRIDGE_GOOGLE_BACKEND_PORT)</string>
</dict></plist>
